# Export variables in your shell; this file is not loaded automatically.
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=
LEXMOUNT_BASE_URL=https://api.lexmount.cn
LEXMOUNT_FETCH_ENGINE=http
# Alternatively use a previously authenticated CLI (absolute path):
# LEXMOUNT_FETCH_CLI=/absolute/path/to/webfetch-cli
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_JSON_MODE=true
MODEL_MAX_TOKENS=16384
MODEL_THINKING=disabled
MODEL_MAX_CALLS=20
# Local author/contact/context profile for publishing generated works:
# AUTOLEX_RELEASE_PROFILE=/absolute/path/to/.release-profile.json
# LEXMOUNT_BROWSER_CLI=/absolute/path/to/browser-cli

# Optional automatic screenshot review (requires Playwright Chromium)
AUTOLEX_VISUAL_REVIEW=false
# Optional existing browser instead of local Chromium
# AUTOLEX_VISUAL_CDP=http://127.0.0.1:9229
