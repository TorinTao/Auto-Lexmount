[Unit]
Description=Auto Lexmount public HTTPS gateway
After=network-online.target autolex.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/auto-lexmount/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/auto-lexmount/nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -c /etc/auto-lexmount/nginx.conf -s reload
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure

[Install]
WantedBy=multi-user.target
